<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<VBox fx:id="taskSideBar"
      visible="false"
      prefHeight="970.0"
      prefWidth="296.0"
      style="-fx-background-color: #B2AFAF;"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1">

    <!-- Title -->
    <Label layoutX="20.0" layoutY="10.0" text="Current task" textFill="WHITE">
        <font>
            <Font size="20.0" />
        </font>
    </Label>

    <!-- Task Sidebar Container Changed to VBox -->
    <VBox layoutX="20.0" layoutY="45.0" prefHeight="250.0" prefWidth="250.0"
          style="-fx-background-color: #625E5E; -fx-background-radius: 10;">

        <!-- Task Title with Status Dot -->
        <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding: 5 5 5 5;">
            <Label style="-fx-font-size: 16px;" text="Task 3" textFill="WHITE" />
            <Circle fill="ORANGE" radius="6.0" />
        </HBox>

        <!-- Task Steps List (Populated Dynamically) -->
        <VBox fx:id="taskListContainer"
              prefHeight="200.0"
              prefWidth="230.0"
              spacing="10.0"
              style="-fx-background-radius: 6; -fx-background-color:#D9D9D9">
            <padding>
                <Insets left="10.0" />
            </padding>
        </VBox>
    </VBox>
</VBox>
