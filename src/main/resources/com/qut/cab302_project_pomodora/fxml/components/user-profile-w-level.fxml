<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<!-- The Pane here is necessary for Scene Builder to properly render the AnchorPane (Since it is so small apparently) -->

<Pane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.qut.cab302_project_pomodora.controller.NavbarController">
      <AnchorPane fx:id="userProfilePaneWLevel" prefHeight="100.0" prefWidth="296.0" styleClass="pomodora-box">
          <Label fx:id="usernameLabelWLevel" layoutX="157.0" layoutY="30.0" text="User _" textFill="WHITE">
              <font>
                  <Font size="28.0" />
              </font>
          </Label>
          <ImageView fx:id="userIndicatorIconWLevel" fitHeight="66.0" fitWidth="75.0" layoutX="8.0" layoutY="20.0" pickOnBounds="true" preserveRatio="true">
              <Image url="@../../images/User-indicator.png" />
          </ImageView>
      </AnchorPane>
</Pane>

<!-- This component should have had a progress bar for the user, as part
 of the gamification aspect initally discussed. Due to lack of time, this feature was cut out.
 Hence, the user profile no bar component is used everywhere instead. -->